# Database
POSTGRES_DB=vms
POSTGRES_USER=vms
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (use a random string of 32+ chars)
JWT_SECRET=change_me_to_a_long_random_secret_32chars_min
JWT_EXPIRY_MINUTES=480

# Mail (Mailpit for local dev)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=your-account@gmail.com

# App
SPRING_PROFILES_ACTIVE=local
FRONTEND_URL=https://localhost
GRAFANA_PASSWORD=change_me
SEED_ADMIN_EMAIL=admin@vms.local
SEED_ADMIN_PASSWORD=change_me

# File storage (local | minio)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=vms
